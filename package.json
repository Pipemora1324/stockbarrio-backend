{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST para el control de stock de tiendas de barrio",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/migrations', 'dist/migrations', { recursive: true })\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": ["express", "postgresql", "api"],
  "author": "StockBarrio IA",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
