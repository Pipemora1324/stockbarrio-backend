NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_barrios
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200
# IA: con AI_PROVIDER=local (o sin clave) todo funciona con reglas locales.
# Cualquier otro valor (por ejemplo "openai") usa proveedores compatibles con la API de OpenAI.
AI_PROVIDER=local
# Principal (ejemplo con Groq). AI_MODELS es la cadena de modelos; si no se define, se usa solo OPENAI_MODEL.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
AI_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
OPENAI_API_KEY=
# Respaldo opcional (ejemplo con Gemini), usado cuando todos los modelos principales se agotan o fallan.
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
AI_FALLBACK_API_KEY=
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=300
AI_MAX_PROMPT_TOKENS=700
AI_CACHE_TTL_MS=60000
# Presupuesto por modelo del principal (un poco por debajo del cupo gratuito: 30/min, 1.000/día, 8K tokens/min, 200K tokens/día)
AI_REQUESTS_PER_MINUTE=28
AI_REQUESTS_PER_DAY=950
AI_TOKENS_PER_MINUTE=7000
AI_TOKENS_PER_DAY=150000
# Presupuesto por modelo del respaldo (Gemini gratis: 5-10/min y 20/día)
AI_FALLBACK_REQUESTS_PER_MINUTE=5
AI_FALLBACK_REQUESTS_PER_DAY=20
AI_FALLBACK_TOKENS_PER_MINUTE=7000
AI_FALLBACK_TOKENS_PER_DAY=150000
# Mensajes del chat que usan IA, por usuario (o por IP sin sesión). Al pasarse, el chat responde con reglas.
AI_CHAT_PER_MINUTE=5
AI_CHAT_PER_DAY=30
# Límite general del chat por IP y por usuario
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=100
# Alertas y notificaciones: apagadas por defecto. Con false, aprobar descuentos no genera notificaciones
# (los endpoints y las tablas siguen ahí). Pon true para reactivarlas, junto con enableAlerts en el frontend.
ENABLE_ALERTS=false
NOTIFICATIONS_DAILY_LIMIT=10
# Dirección pública del frontend, para los enlaces de los correos
APP_URL=http://localhost:4200
# Correo (opcional). Sin SMTP_HOST, en desarrollo el enlace se imprime en la consola
# y en producción la API responde que el correo no está configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockBarrio <no-responder@tu-dominio.com>

# Solo para el script manual npm run seed (no hacen falta en Render)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_STORE_PASSWORD=tienda12345

# Base de datos desechable para los tests de integración (el nombre debe terminar en _test)
TEST_DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_barrios_test
