NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_barrios
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Autenticación: legacy (login propio, por defecto) o supabase (Supabase Auth). Guía en SUPABASE_AUTH.md.
AUTH_PROVIDER=legacy
# Solo con AUTH_PROVIDER=supabase. <ref> es el identificador del proyecto de Supabase.
SUPABASE_URL=
# Si el proyecto usa claves de firma (Project Settings > JWT Keys: ECC o RSA). No es un secreto.
SUPABASE_JWKS_URL=
# Solo si el proyecto aún firma con el Legacy JWT Secret (HS256). Es un secreto: nunca lo subas al repositorio.
SUPABASE_JWT_SECRET=
CORS_ORIGIN=http://localhost:4200
# IA: con AI_PROVIDER=local (o sin clave) todo funciona con reglas locales.
# Cualquier otro valor (por ejemplo "openai") usa proveedores compatibles con la API de OpenAI.
AI_PROVIDER=local
# Principal (ejemplo con Groq). AI_MODELS es la cadena de modelos; si no se define, se usa solo OPENAI_MODEL.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
AI_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
OPENAI_API_KEY=
# Respaldo opcional (ejemplo con Gemini), usado cuando todos los modelos principales se agotan o fallan.
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
AI_FALLBACK_API_KEY=
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=300
AI_MAX_PROMPT_TOKENS=700
AI_CACHE_TTL_MS=60000
# Presupuesto por modelo del principal (un poco por debajo del cupo gratuito: 30/min, 1.000/día, 8K tokens/min, 200K tokens/día)
AI_REQUESTS_PER_MINUTE=28
AI_REQUESTS_PER_DAY=950
AI_TOKENS_PER_MINUTE=7000
AI_TOKENS_PER_DAY=150000
# Presupuesto por modelo del respaldo (Gemini gratis: 5-10/min y 20/día)
AI_FALLBACK_REQUESTS_PER_MINUTE=5
AI_FALLBACK_REQUESTS_PER_DAY=20
AI_FALLBACK_TOKENS_PER_MINUTE=7000
AI_FALLBACK_TOKENS_PER_DAY=150000
# Mensajes del chat que usan IA, por usuario (o por IP sin sesión). Al pasarse, el chat responde con reglas.
AI_CHAT_PER_MINUTE=5
AI_CHAT_PER_DAY=30
# Límite general del chat por IP y por usuario
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=100
# Alertas y notificaciones: apagadas por defecto. Con false, aprobar descuentos no genera notificaciones
# (los endpoints y las tablas siguen ahí). Pon true para reactivarlas, junto con enableAlerts en el frontend.
ENABLE_ALERTS=false
NOTIFICATIONS_DAILY_LIMIT=10
# Dirección pública del frontend, sin "/" al final. Los enlaces de los correos se arman solo con ella.
# En producción es obligatoria para enviar correos (por ejemplo https://tu-app.vercel.app).
APP_URL=http://localhost:4200

# Correo. MAIL_PROVIDER elige el transporte:
#   smtp (por defecto): servidor SMTP con las variables SMTP_* de abajo.
#   brevo-api: API HTTPS de Brevo. Úsalo en Render Free, que bloquea los puertos SMTP 25, 465 y 587.
#     Necesita BREVO_API_KEY (SMTP & API > API Keys, empieza por xkeysib-) y MAIL_FROM con un
#     remitente verificado en Brevo (Senders), por ejemplo: MAIL_FROM=StockBarrio <avisos@tu-dominio.com>
MAIL_PROVIDER=
BREVO_API_KEY=
#
# Con smtp y sin SMTP_HOST, en desarrollo el correo (con su enlace) se imprime en la consola
# y en producción la API responde que el correo no está configurado. Guía completa en el README.
# Prueba la configuración con: npm run mail:test -- tucorreo@ejemplo.com
#
# Gmail (necesita la verificación en 2 pasos y una contraseña de aplicación de 16 letras, sin espacios):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=tucorreo@gmail.com  SMTP_PASS=abcdefghijklmnop  MAIL_FROM=StockBarrio <tucorreo@gmail.com>
# Brevo (MAIL_FROM debe ser un remitente verificado en Brevo):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=tu-login@smtp-brevo.com  SMTP_PASS=tu-clave-smtp  MAIL_FROM=StockBarrio <avisos@tu-dominio.com>
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (TLS directo), false para el 587 (STARTTLS). Vacío: se deduce del puerto.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Con smtp, vacío usa SMTP_USER como remitente. Con brevo-api es obligatorio y debe estar verificado en Brevo.
MAIL_FROM=
# Límite en milisegundos para conectar y para enviar, con los dos transportes.
MAIL_TIMEOUT_MS=10000

# Solo para scripts manuales (no hacen falta en Render):
# npm run admin:create crea o actualiza el administrador (contraseña de 12 caracteres o más)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# npm run seed:dev carga tiendas de ejemplo, solo en desarrollo (se niega con NODE_ENV=production)
SEED_STORE_PASSWORD=tienda12345

# Base de datos desechable para los tests de integración (el nombre debe terminar en _test)
TEST_DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_barrios_test
