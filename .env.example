NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_barrios
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200
# IA: con AI_PROVIDER=local (o sin clave) todo funciona con reglas locales.
# Cualquier otro valor (por ejemplo "openai") usa un proveedor compatible con la API de OpenAI.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Ejemplo con Gemini como principal:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.5-flash
#   OPENAI_API_KEY=tu-clave-de-gemini
# Proveedor de respaldo opcional (se usa si el principal responde 429, 5xx, tarda o devuelve algo inválido).
# Ejemplo con Groq:
#   AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#   AI_FALLBACK_MODEL=llama-3.3-70b-versatile
#   AI_FALLBACK_API_KEY=tu-clave-de-groq
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=700
AI_CACHE_TTL_MS=60000
# Límites del chat por IP y por usuario
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=100
NOTIFICATIONS_DAILY_LIMIT=10

# Solo para el script manual npm run seed (no hacen falta en Render)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_STORE_PASSWORD=tienda12345

# Base de datos desechable para los tests de integración (el nombre debe terminar en _test)
TEST_DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_barrios_test
